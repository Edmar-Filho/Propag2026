programa
{
	
	funcao inicio()
	{
		inteiro num1, num2
		escreva("1º nº: ")
		leia(num1)
		escreva("\n")
		escreva("2º nº: ")
		leia(num2)
		soma(num1,num2)
	}
	funcao soma(inteiro a,inteiro b){
		escreva("Soma: ", a+b)
	}
}
