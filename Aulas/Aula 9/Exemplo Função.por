programa
{
	
	funcao inicio()
	{
		mensagem("Senai",2026)
	}

	funcao mensagem(cadeia empresa, inteiro ano)
	{
		escreva("********************", "\n")
		escreva("*** ", empresa," - ", ano," - ","***", "\n")
		escreva("********************", "\n")
		}
}
